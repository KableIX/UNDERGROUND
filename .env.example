# UNDERGROUND environment template — copy to .env and fill locally.
# Never commit real secrets.

# App
NODE_ENV=development
APP_ENV=development

# Supabase (leave empty until credentials exist)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local PostGIS (docker compose up -d postgis) — optional durable mode
DATABASE_URL=

# Mapbox — never commit real tokens
# Public runtime (pk.*) for MapView / Static API — safe for EXPO_PUBLIC_* only if pk scoped
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
# Private download (sk.*) for native SDK at EAS/prebuild — EAS secret RNMAPBOX_MAPS_DOWNLOAD_TOKEN
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
MAPBOX_SECRET_TOKEN=

# API
API_HOST=0.0.0.0
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787

# Expo / EAS (stubs only — do not invent project IDs or tokens)
EXPO_TOKEN=
EAS_PROJECT_ID=

# Observability
SENTRY_DSN=
