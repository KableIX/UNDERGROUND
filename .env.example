# UNDERGROUND environment template — copy to .env and fill locally.
# Never commit real secrets.

# App
NODE_ENV=development
APP_ENV=development

# Supabase (leave empty until credentials exist)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Local PostGIS (docker compose up -d postgis) — optional durable mode
DATABASE_URL=

# Mapbox — never commit real tokens
# Public runtime (pk.*) for MapView / Static API — safe for EXPO_PUBLIC_* only if pk scoped
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
MAPBOX_ACCESS_TOKEN=
# Private download (sk.*) for native SDK at EAS/prebuild — EAS secret RNMAPBOX_MAPS_DOWNLOAD_TOKEN
RNMAPBOX_MAPS_DOWNLOAD_TOKEN=
MAPBOX_SECRET_TOKEN=

# API
API_HOST=0.0.0.0
API_PORT=8787
API_PUBLIC_URL=http://localhost:8787

# Expo / EAS (stubs only — do not invent project IDs or tokens)
EXPO_TOKEN=
EAS_PROJECT_ID=

# Observability
SENTRY_DSN=

# Spotted photo identification (server only, OpenAI-compatible vision endpoint)
# Aphrodite: http://127.0.0.1:11434/v1/chat/completions with qwen3-vl:2b
SPOTTED_VISION_URL=
SPOTTED_VISION_MODEL=
SPOTTED_VISION_KEY=

# Finish photo anti-cheat (services/api). See docs/finish-photo-anti-cheat.md.
# HMAC secret (>= 32 chars) for finish nonces and attestation challenges. Required in production.
FINISH_NONCE_SECRET=
# true = require device attestation for photo credit (fail closed). false/empty = permissive.
APP_INTEGRITY_REQUIRED=false
# Apple App Attest: <TEAM_ID>.<bundle id>, and production | development (matches the entitlement).
APPLE_APP_ATTEST_APP_ID=
APPLE_APP_ATTEST_ENVIRONMENT=production
# Android package for Play Integrity (stub: not verified yet).
ANDROID_PACKAGE_NAME=
