{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Lets TypeScript accept a lazy `import()`, which the bundler already supports. Expo's base
    // config leaves this unset, and TypeScript then falls back to a module kind without it.
    "module": "ESNext",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
